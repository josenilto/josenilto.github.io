# Copie para .env e ajuste os valores
# cp .env.example .env

# Path do banco SQLite no host (persiste entre deploys)
# Em produção, use um path absoluto fora do projeto:
#   DATA_DIR=/opt/portfolio/data
DATA_DIR=./data

# Path dos backups automáticos (criados pelo deploy.sh)
BACKUP_DIR=./backups

# Chave secreta para os endpoints POST /api/metrics e /api/deployments
# Gere com: openssl rand -hex 32
API_SECRET_KEY=
