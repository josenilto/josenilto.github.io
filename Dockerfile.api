# ══════════════════════════════════════════════════════════════════
#  portfolio-api — API REST + SQLite
#  Stage 1 (builder): compila better-sqlite3 (nativo C++) no Alpine
#  Stage 2 (production): imagem enxuta sem ferramentas de build
# ══════════════════════════════════════════════════════════════════

# ── Stage 1: Build ────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY api/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM node:22-alpine AS production

LABEL org.opencontainers.image.title="portfolio-api" \
      org.opencontainers.image.description="API REST + SQLite para o portfólio josenilto.github.io"

# su-exec: troca de usuário sem shell extra (like gosu, mas Alpine-nativo)
RUN apk upgrade --no-cache && apk add --no-cache su-exec

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY api/server.js      ./server.js
COPY api/entrypoint.sh  ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# /data criado no build; bind mount do compose substitui em runtime.
# O entrypoint.sh (root) corrige chown antes de exec su-exec node.
RUN mkdir -p /data

ENV PORT=3000 \
    DB_PATH=/data/portfolio.db \
    NODE_ENV=production

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

# Inicia como root para poder corrigir permissoes em /data
ENTRYPOINT ["./entrypoint.sh"]
