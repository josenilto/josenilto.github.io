# ══════════════════════════════════════════════════════════════════
#  portfolio-api — API REST + SQLite
#  Stage 1 (builder): compila better-sqlite3 (nativo C++) no Alpine
#  Stage 2 (production): imagem enxuta sem ferramentas de build
# ══════════════════════════════════════════════════════════════════

# ── Stage 1: Build ────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY api/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM node:22-alpine AS production

LABEL org.opencontainers.image.title="portfolio-api" \
      org.opencontainers.image.description="API REST + SQLite para o portfólio josenilto.github.io"

RUN apk upgrade --no-cache

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY api/server.js ./

# Diretório de dados — sobrescrito pelo volume no compose
RUN mkdir -p /data && chown node:node /data

ENV PORT=3000 \
    DB_PATH=/data/portfolio.db \
    NODE_ENV=production

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
